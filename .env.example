# ============================================================
# jm-notification - Plantilla de variables de entorno
# ============================================================
# cp .env.example .env   (o copia manual en Windows)
# Completa los valores secretos en .env (no se versiona).
# ============================================================

# --- Servidor ---
SERVER_PORT=8050

# --- Base de datos ---
# El driver JDBC se deriva de la URL: no hay que configurarlo aparte.
# Postgres:  jdbc:postgresql://localhost:5433/jm_notification
# H2 fichero: jdbc:h2:file:./data/jm-notification;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
#   (H2 sólo está declarado con scope test: para usarlo en runtime hay que
#    cambiar ese scope en el pom.xml)
DB_URL=jdbc:postgresql://localhost:5433/jm_notification
DB_USER=postgres
DB_PASSWORD=postgres
# Esquema gestionado por JPA (update / validate / none). No hay Flyway.
JPA_DDL_AUTO=update
# Consola H2 en /h2-console. Desactivada por defecto.
H2_CONSOLE_ENABLED=false

# --- Timeouts HTTP salientes (Telegram / Meta) ---
HTTP_CONNECT_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s

# --- Email ---
NOTIFICATION_EMAIL_ENABLED=true
# Remitente por defecto cuando la cuenta SMTP no define fromAddress.
MAIL_FROM=
# Clave AES (16/24/32 bytes) en Base64 para cifrar passwords SMTP en BD.
# Genera una: openssl rand -base64 32
# OBLIGATORIA en cualquier entorno con datos que deban sobrevivir a un reinicio:
# si se deja vacía se genera una aleatoria al arrancar y los passwords guardados
# antes dejan de poder descifrarse.
EMAIL_PASSWORD_ENCRYPTION_KEY=
# Las cuentas SMTP se gestionan en BD vía /api/v1/admin/email-accounts.
# Ya no se usan MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD.

# --- Auth (Admin / API Key) ---
# Si la tabla admin_users esta vacia, se crea un SUPER_ADMIN con estos valores.
# Requerido solo la primera vez; cambialo luego desde el endpoint o BD.
ADMIN_EMAIL=admin@jmcode.local
ADMIN_PASSWORD=ChangeMe!2026
# Secreto HS256 para firmar JWT. MINIMO 32 caracteres: uno mas corto hace
# fallar el arranque (antes se rellenaba con ceros en silencio).
# Si se deja vacio se genera aleatorio al arranque y los tokens no sobreviven
# a un reinicio.
JWT_SECRET=
# TTL del JWT (default 12h).
JWT_TTL=12h

# --- WhatsApp (Meta Cloud API) ---
NOTIFICATION_WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Telegram ---
NOTIFICATION_TELEGRAM_ENABLED=false
# Los bots se gestionan en BD via /api/v1/admin/telegram-bot-accounts.
# Estas variables son fallback global (legacy).
TELEGRAM_API_URL=https://api.telegram.org
# Secret propio (A-Z a-z 0-9 _ -), 1-256 chars.
# Importante: en cuanto una cuenta activa define webhookSecret, el webhook
# rechaza con 401 las peticiones sin secret valido.
TELEGRAM_WEBHOOK_SECRET=
# Base HTTPS pública del túnel/dominio (sin path) o URL completa del webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_AUTO_REGISTER=false
TELEGRAM_REQUIRE_ACTIVE_SUBSCRIBER=true
# Timeouts para el envio de adjuntos (sendDocument). El read-timeout general de
# HTTP_READ_TIMEOUT es demasiado corto para subir un fichero: si ves
# "Request cancelled" al mandar adjuntos, sube este valor.
TELEGRAM_UPLOAD_CONNECT_TIMEOUT=10s
TELEGRAM_UPLOAD_READ_TIMEOUT=2m
TELEGRAM_WELCOME_MESSAGE=Suscripcion activa. Ya puedes recibir notificaciones.
TELEGRAM_GOODBYE_MESSAGE=Suscripcion cancelada. Usa /start para volver a activarla.
