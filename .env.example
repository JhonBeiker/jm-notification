# ============================================================
# jm-notification - Plantilla de variables de entorno
# ============================================================
# cp .env.example .env   (o copia manual en Windows)
# Completa los valores secretos en .env (no se versiona).
# ============================================================

# --- Servidor ---
SERVER_PORT=8080

# --- Base de datos (H2 por defecto) ---
DB_URL=jdbc:h2:file:./data/jm-notification;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
H2_CONSOLE_ENABLED=true

# --- Email (SMTP) ---
NOTIFICATION_EMAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- WhatsApp (Meta Cloud API) ---
NOTIFICATION_WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Telegram ---
NOTIFICATION_TELEGRAM_ENABLED=false
# Formato obligatorio: <botId>:<secret>  (ej. 8608833641:AAHxxxxx)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Secret propio (A-Z a-z 0-9 _ -), 1-256 chars
TELEGRAM_WEBHOOK_SECRET=
# Base HTTPS pública del túnel/dominio (sin path) o URL completa del webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_AUTO_REGISTER=false
TELEGRAM_REQUIRE_ACTIVE_SUBSCRIBER=true
TELEGRAM_WELCOME_MESSAGE=Suscripcion activa. Ya puedes recibir notificaciones.
TELEGRAM_GOODBYE_MESSAGE=Suscripcion cancelada. Usa /start para volver a activarla.
